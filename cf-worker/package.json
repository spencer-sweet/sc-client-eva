{
  "name": "eva-networks-webflow-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "dotenv -e .env -- wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "cloudflared": "^0.7.3",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
